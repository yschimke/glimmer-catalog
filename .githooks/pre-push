#!/usr/bin/env bash
set -uo pipefail

remote="${1:-origin}"
scan="$(git rev-parse --show-toplevel)/.github/scripts/agent-attribution-scan.sh"
zero="$(git hash-object --stdin </dev/null | tr '[:xdigit:]' '0')"
failed=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ]; then
    "$scan" --range "${remote_sha}..${local_sha}" || failed=1
    continue
  fi

  advertised="$(git ls-remote --heads "$remote")" || {
    echo "pre-push: cannot list remote heads; refusing an unscanned push" >&2
    failed=1
    continue
  }
  set -- --rev-args "$local_sha"
  while read -r advertised_sha _advertised_ref; do
    [ -n "$advertised_sha" ] || continue
    if git cat-file -e "${advertised_sha}^{commit}" 2>/dev/null; then
      set -- "$@" "^${advertised_sha}"
    fi
  done <<HEADS
$advertised
HEADS
  "$scan" "$@" || failed=1
done

exit "$failed"
